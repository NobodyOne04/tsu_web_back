@{ ViewData["Title"] = "Your account"; }
<h2>Your account</h2>
@if (ViewData["StatusMessage"] is string message) { <p class="text-success">@message</p> }
<p>Signed in as <strong>@ActorAccessor.Current?.UserName</strong>.</p>
<a asp-action="ChangePassword" class="btn btn-default">Change password</a>
