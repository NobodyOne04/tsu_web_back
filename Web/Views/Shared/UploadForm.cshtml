@model UploadForm
<h2>@ViewData["Title"]</h2>
<p class="text-muted">Up to @(Rules.MaxUploadBytes / 1024 / 1024) MB. Images show inline; other files download.</p>
<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group"><input asp-for="File" type="file" /></div>
    <button type="submit" class="btn btn-primary">Upload</button>
    <a href="@ViewData["Back"]" class="btn btn-link">Cancel</a>
</form>
