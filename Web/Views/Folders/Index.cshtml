@model IReadOnlyList<Folder>
@{ ViewData["Title"] = "Drive"; }
<h2>Drive</h2>
<p><a asp-action="Create" class="btn btn-default">New folder</a></p>
<ul class="list-group">
    @foreach (var f in Model) { <li class="list-group-item"><span class="glyphicon glyphicon-folder-close"></span> <a asp-action="Details" asp-route-id="@f.Id">@f.Name</a></li> }
</ul>
@if (Model.Count == 0) { <p class="text-muted">No folders yet.</p> }
