@model Folder
@{ ViewData["Title"] = Model.Name; }
<p>
    <a asp-action="Index">Drive</a>
    @if (Model.Parent is not null) { <text>/</text> <a asp-action="Details" asp-route-id="@Model.Parent.Id">@Model.Parent.Name</a> }
    / @Model.Name
</p>
<h2>@Model.Name</h2>
<p>
    <a asp-action="Create" asp-route-parentId="@Model.Id" class="btn btn-default btn-sm">New folder</a>
    <a asp-controller="Files" asp-action="Create" asp-route-folderId="@Model.Id" class="btn btn-default btn-sm">Upload</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-link btn-sm">Rename</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-link btn-sm">Delete</a>
</p>
<ul class="list-group">
    @foreach (var f in Model.Folders.OrderBy(x => x.Name))
    {
        <li class="list-group-item"><span class="glyphicon glyphicon-folder-close"></span> <a asp-action="Details" asp-route-id="@f.Id">@f.Name</a></li>
    }
    @foreach (var f in Model.Files.OrderBy(x => x.Name))
    {
        <li class="list-group-item">
            <span class="glyphicon glyphicon-file"></span>
            <a asp-controller="Files" asp-action="Download" asp-route-id="@f.Id">@f.Name@f.Extension</a>
            <span class="text-muted">(@(f.Size < 1024 ? $"{f.Size} B" : $"{f.Size / 1024} KB"))</span>
            <span class="pull-right"><a asp-controller="Files" asp-action="Edit" asp-route-id="@f.Id">Rename</a> &middot; <a asp-controller="Files" asp-action="Delete" asp-route-id="@f.Id">Delete</a></span>
        </li>
    }
</ul>
@if (Model.Folders.Count == 0 && Model.Files.Count == 0) { <p class="text-muted">Empty.</p> }
