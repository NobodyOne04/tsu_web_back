@model IReadOnlyList<ForumCategory>
@{
    ViewData["Title"] = "Forum";
    var admin = ActorAccessor.Current?.IsAdmin == true;
}
<h2>Forum</h2>
@if (admin) { <p><a asp-controller="ForumCategories" asp-action="Create" class="btn btn-default">New category</a></p> }
@foreach (var category in Model)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>@category.Name</strong>
            @if (admin)
            {
                <span class="pull-right">
                    <a asp-controller="Forums" asp-action="Create" asp-route-categoryId="@category.Id">New forum</a> &middot;
                    <a asp-controller="ForumCategories" asp-action="Edit" asp-route-id="@category.Id">Rename</a> &middot;
                    <a asp-controller="ForumCategories" asp-action="Delete" asp-route-id="@category.Id">Delete</a>
                </span>
            }
        </div>
        <table class="table">
            @foreach (var f in category.Forums.OrderBy(x => x.Name))
            {
                <tr>
                    <td><a asp-controller="ForumTopics" asp-action="Index" asp-route-forumId="@f.Id"><strong>@f.Name</strong></a><br /><span class="text-muted">@f.Description</span></td>
                    @if (admin) { <td class="text-right"><a asp-controller="Forums" asp-action="Edit" asp-route-id="@f.Id">Edit</a> &middot; <a asp-controller="Forums" asp-action="Delete" asp-route-id="@f.Id">Delete</a></td> }
                </tr>
            }
        </table>
    </div>
}
@if (Model.Count == 0) { <p class="text-muted">No forums yet.</p> }
