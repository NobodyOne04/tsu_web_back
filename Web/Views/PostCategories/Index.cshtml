@model IReadOnlyList<PostCategory>
@{ ViewData["Title"] = "Blog categories"; }
<h2>Blog categories</h2>
<p><a asp-action="Create" class="btn btn-default">New category</a></p>
<table class="table">
    @foreach (var c in Model)
    {
        <tr><td>@c.Name</td><td class="text-right"><a asp-action="Edit" asp-route-id="@c.Id">Rename</a> &middot; <a asp-action="Delete" asp-route-id="@c.Id">Delete</a></td></tr>
    }
</table>
