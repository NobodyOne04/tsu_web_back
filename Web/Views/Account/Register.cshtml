@model RegisterForm
@{ ViewData["Title"] = "Register"; }
<h2>Register</h2>
<div class="row"><div class="col-md-5">
    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autofocus /></div>
        <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" /></div>
        <div class="form-group"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">Register</button>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
