@model LoginForm
@{ ViewData["Title"] = "Log in"; }
<h2>Log in</h2>
<div class="row"><div class="col-md-5">
    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autofocus /></div>
        <div class="form-group"><label asp-for="Password"></label><input asp-for="Password" class="form-control" /></div>
        <div class="checkbox"><label><input asp-for="RememberMe" /> @Html.DisplayNameFor(m => m.RememberMe)</label></div>
        <button type="submit" class="btn btn-primary">Log in</button>
        <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-link">Register instead</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
