@model IReadOnlyList<Post>
@{ ViewData["Title"] = "Blog"; }
<h2>Blog</h2>
@if (ActorAccessor.Current is not null) { <p><a asp-action="Create" class="btn btn-default">New post</a></p> }
@foreach (var post in Model)
{
    <div class="panel panel-default">
        <div class="panel-heading"><a asp-action="Details" asp-route-id="@post.Id"><strong>@post.Title</strong></a></div>
        <div class="panel-body">@post.AuthorName &middot; @post.Category.Name &middot; @post.Created.ToString("g")</div>
    </div>
}
@if (Model.Count == 0) { <p class="text-muted">No posts yet.</p> }
