@model ForumTopic
@{
    ViewData["Title"] = Model.Name;
    var actor = ActorAccessor.Current;
}
<p><a asp-controller="Forum" asp-action="Index">Forum</a> / <a asp-controller="ForumTopics" asp-action="Index" asp-route-forumId="@Model.ForumId">@Model.Forum.Name</a></p>
<h2>@Model.Name</h2>
<p class="text-muted">
    Started by @Model.AuthorName &middot; @Model.Created.ToString("g")
    @if (Model.CanEdit(actor))
    {
        <text>&middot;</text> <a asp-controller="ForumTopics" asp-action="Edit" asp-route-id="@Model.Id">Rename</a>
        <text>&middot;</text> <a asp-controller="ForumTopics" asp-action="Delete" asp-route-id="@Model.Id">Delete topic</a>
    }
</p>
@foreach (var m in Model.Messages.OrderBy(x => x.Created))
{
    var mine = m.CanEdit(actor);
    <div class="panel panel-default">
        <div class="panel-heading">
            @m.AuthorName &middot; @m.Created.ToString("g")@(m.Modified > m.Created ? " (edited)" : "")
            @if (mine)
            {
                <span class="pull-right">
                    <a asp-action="Edit" asp-route-id="@m.Id">Edit</a> &middot;
                    <a asp-action="Attach" asp-route-id="@m.Id">Attach</a> &middot;
                    <a asp-action="Delete" asp-route-id="@m.Id">Delete</a>
                </span>
            }
        </div>
        <div class="panel-body">
            <div style="white-space: pre-wrap">@m.Text</div>
            @if (m.Attachments.Count > 0)
            {
                <div class="row" style="margin-top: 10px">
                    @foreach (var a in m.Attachments.OrderBy(x => x.Created))
                    {
                        <div class="col-sm-6 col-md-4"><div class="thumbnail">
                            @if (a.IsImage) { <img src="@Url.Action("Attachment", new { id = a.Id })" alt="@a.FileName" /> }
                            <div class="caption">
                                <a asp-action="Attachment" asp-route-id="@a.Id">@a.FileName</a>
                                @if (mine) { <text>&middot;</text> <a asp-action="DeleteAttachment" asp-route-id="@a.Id" class="text-danger">Delete</a> }
                            </div>
                        </div></div>
                    }
                </div>
            }
        </div>
    </div>
}
@if (actor is not null) { <a asp-action="Create" asp-route-topicId="@Model.Id" class="btn btn-default">Reply</a> }
else { <p><a asp-controller="Account" asp-action="Login">Log in</a> to reply.</p> }
