@model IReadOnlyList<ForumTopic>
@{
    var forum = (Forum)ViewData["Forum"]!;
    ViewData["Title"] = forum.Name;
}
<p><a asp-controller="Forum" asp-action="Index">Forum</a> / @forum.Category.Name</p>
<h2>@forum.Name</h2>
<p class="text-muted">@forum.Description</p>
@if (ActorAccessor.Current is not null) { <p><a asp-action="Create" asp-route-forumId="@forum.Id" class="btn btn-default">New topic</a></p> }
<table class="table table-striped">
    @foreach (var t in Model)
    {
        <tr>
            <td><a asp-controller="ForumMessages" asp-action="Index" asp-route-topicId="@t.Id"><strong>@t.Name</strong></a><br /><span class="text-muted">@t.AuthorName &middot; @t.Created.ToString("g")</span></td>
            <td class="text-right">@t.Messages.Count messages</td>
        </tr>
    }
</table>
@if (Model.Count == 0) { <p class="text-muted">No topics yet.</p> }
